# Copy to .env and fill in. Never commit the real .env or any private key file.

SF_USER=
SF_ACCOUNT=
SF_DATABASE=
SF_SCHEMA=
SF_WAREHOUSE=
SF_ROLE=

# --- Auth: pick ONE of the two options below ---

# Option A: key-pair auth (preferred — Snowflake is deprecating single-factor
# password auth). Generate a key pair and register the public key on your
# Snowflake user, then point this at the private key file's path.
SF_PRIVATE_KEY_PATH=
# Only needed if the private key was generated with a passphrase.
SF_PRIVATE_KEY_PASSPHRASE=

# Option B: password auth (legacy fallback, may be disabled on your account).
SF_PASSWORD=
