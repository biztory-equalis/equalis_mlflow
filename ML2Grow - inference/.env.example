# Copy to .env and fill in. Never commit the real .env or any private key file.
#
# This file is only for local development. When running as a Snowpark
# Container Services job, none of this is needed — Snowflake auto-injects a
# session token at /snowflake/session/token plus SNOWFLAKE_ACCOUNT /
# SNOWFLAKE_HOST env vars, and SnowflakeConfig picks those up automatically
# and authenticates via OAuth instead (see config/snowflake_config.py).
# SNOWFLAKE_DATABASE / SNOWFLAKE_SCHEMA / SNOWFLAKE_WAREHOUSE still need to be
# set explicitly in the service spec, same as the SF_* vars below locally.

SF_USER=
SF_ACCOUNT=
SF_DATABASE=
SF_SCHEMA=
SF_WAREHOUSE=
SF_ROLE=

# --- Auth: pick ONE of the two options below (ignored in SPCS, see above) ---

# Option A: key-pair auth (preferred — Snowflake is deprecating single-factor
# password auth). Generate a key pair and register the public key on your
# Snowflake user, then point this at the private key file's path.
SF_PRIVATE_KEY_PATH=
# Only needed if the private key was generated with a passphrase.
SF_PRIVATE_KEY_PASSPHRASE=

# Option B: password auth (legacy fallback, may be disabled on your account).
SF_PASSWORD=
